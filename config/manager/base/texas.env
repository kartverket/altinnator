# Becomes the ConfigMap altinnator-texas: the settings of Texas (https://github.com/nais/texas) that are not secret. The
# key is in maskinporten.env.
#
# Texas runs in a container in the pod, where the Altinn mock from compose.yaml on your host is host.docker.internal.
# Texas will not start without a JWKS, which it fetches when it starts and only uses to check tokens it is asked to
# introspect. It gets test Maskinporten's public one, since CI cannot reach the mock.
MASKINPORTEN_CLIENT_ID=dev-client
MASKINPORTEN_ISSUER=http://host.docker.internal:8090/
MASKINPORTEN_TOKEN_ENDPOINT=http://host.docker.internal:8090/token
MASKINPORTEN_JWKS_URI=https://test.maskinporten.no/jwk
